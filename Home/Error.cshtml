@model ErrorVm
@{ ViewData["Title"] = Model.Title; }
<div class="rd-panel text-center mx-auto" style="max-width:36rem">
    <div class="rd-error-code">@Model.Code</div>
    <h1 class="rd-h1">@Model.Title</h1>
    <p class="text-muted">@Model.Message</p>
    <a class="btn btn-rd-primary" asp-controller="Home" asp-action="Index">Back to RaceDay</a>
</div>
