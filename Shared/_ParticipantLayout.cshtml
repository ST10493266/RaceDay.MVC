@{
    Layout = "_Base";
    ViewData["BodyClass"] = "role-participant";
    var name = Context.Session.CurrentName();
    var action = (ViewContext.RouteData.Values["action"] as string) ?? "";
    string Active(params string[] actions) => actions.Contains(action, StringComparer.OrdinalIgnoreCase) ? "active" : "";
}
<header class="rd-topbar">
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="rd-brand" asp-controller="Participant" asp-action="Index"><span class="rd-brand-mark"></span>RaceDay</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#rdNav" aria-controls="rdNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="rdNav">
                <ul class="navbar-nav me-auto ms-lg-4">
                    <li class="nav-item"><a class="nav-link @Active("Index", "Details")" asp-controller="Participant" asp-action="Index">Find events</a></li>
                    <li class="nav-item"><a class="nav-link @Active("MyEnrolments")" asp-controller="Participant" asp-action="MyEnrolments">My enrolments</a></li>
                    <li class="nav-item"><a class="nav-link @Active("MyResults")" asp-controller="Participant" asp-action="MyResults">My results</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Profile")" asp-controller="Participant" asp-action="Profile">Profile</a></li>
                </ul>
                <div class="d-flex align-items-center gap-3">
                    <span class="rd-role-tag">Runner</span>
                    <span class="text-white-50 small">@name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        <button type="submit" class="btn btn-outline-light btn-sm">Log out</button>
                    </form>
                </div>
            </div>
        </div>
    </nav>
</header>
<main class="container rd-main">
    <partial name="_Flash" />
    @RenderBody()
</main>
