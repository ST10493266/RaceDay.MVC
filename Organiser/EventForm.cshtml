@model EventFormVm
@{
    var editing = Model.Id.HasValue;
    ViewData["Title"] = editing ? "Edit event" : "New event";
    var types = new[] { "Road run", "Trail run", "Fun run", "Marathon", "Cycling", "Triathlon", "Other" };
}
<div class="rd-pagehead">
    <h1 class="rd-h1">@(editing ? "Edit event" : "New event")</h1>
    <p class="text-muted mb-0">@(editing ? "Update the details runners see." : "Tell runners what, when and where.")</p>
</div>

<div class="rd-panel">
    <form asp-action="@(editing ? "EditEvent" : "CreateEvent")" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger rd-alert"></div>
        <input type="hidden" asp-for="ExistingBannerUrl" />
        <div class="row">
            <div class="col-lg-8 mb-3">
                <label asp-for="Name" class="form-label">Event name</label>
                <input asp-for="Name" class="form-control" required />
                <span asp-validation-for="Name" class="rd-field-error"></span>
            </div>
            <div class="col-lg-4 mb-3">
                <label asp-for="EventType" class="form-label"></label>
                <select asp-for="EventType" class="form-select" required>
                    <option value="">Choose a type</option>
                    @foreach (var t in types)
                    {
                        <option value="@t" selected="@(Model.EventType == t)">@t</option>
                    }
                </select>
                <span asp-validation-for="EventType" class="rd-field-error"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="4" required></textarea>
            <span asp-validation-for="Description" class="rd-field-error"></span>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="EventDate" class="form-label"></label>
                <input asp-for="EventDate" class="form-control" type="datetime-local" value="@Model.EventDate?.ToString("yyyy-MM-ddTHH:mm")" required />
                <span asp-validation-for="EventDate" class="rd-field-error"></span>
            </div>
            <div class="col-md-5 mb-3">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" required />
                <span asp-validation-for="Location" class="rd-field-error"></span>
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="DistanceKm" class="form-label"></label>
                <input asp-for="DistanceKm" class="form-control" type="number" step="0.1" min="0.1" required />
                <span asp-validation-for="DistanceKm" class="rd-field-error"></span>
            </div>
        </div>
        <div class="mb-4">
            <label asp-for="Banner" class="form-label"></label>
            @if (!string.IsNullOrWhiteSpace(Model.ExistingBannerUrl))
            {
                <div class="mb-2"><img src="@Model.ExistingBannerUrl" alt="Current banner" class="rd-banner-preview" /></div>
                <div class="form-text mb-2">Choose a new image only if you want to replace this one.</div>
            }
            <input asp-for="Banner" class="form-control" type="file" accept="image/png,image/jpeg,image/webp" />
            <div class="form-text">JPG, PNG or WebP, up to 5 MB. A wide image works best.</div>
            <span asp-validation-for="Banner" class="rd-field-error"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-rd-primary">@(editing ? "Save changes" : "Create event")</button>
            <a asp-action="Events" class="btn btn-outline-dark">Cancel</a>
        </div>
    </form>
</div>
