@model ParticipantEventsVm
@{ ViewData["Title"] = "Find events"; }
<div class="rd-pagehead">
    <h1 class="rd-h1">Upcoming events</h1>
    <p class="text-muted mb-0">@Model.TotalUpcoming upcoming @(Model.TotalUpcoming == 1 ? "event" : "events") open for entry.</p>
</div>

<form method="get" asp-action="Index" class="rd-filter" role="search" aria-label="Filter events">
    <div class="row g-3 align-items-end">
        <div class="col-12 col-lg-3">
            <label for="search" class="form-label">Search</label>
            <input id="search" name="search" class="form-control" value="@Model.Search" placeholder="Name, place or keyword" />
        </div>
        <div class="col-6 col-lg-2">
            <label for="eventType" class="form-label">Type</label>
            <select id="eventType" name="eventType" class="form-select">
                <option value="">Any</option>
                @foreach (var t in Model.EventTypes)
                {
                    <option value="@t" selected="@(string.Equals(t, Model.EventType, StringComparison.OrdinalIgnoreCase))">@t</option>
                }
            </select>
        </div>
        <div class="col-6 col-lg-2">
            <label for="location" class="form-label">Location</label>
            <select id="location" name="location" class="form-select">
                <option value="">Anywhere</option>
                @foreach (var l in Model.Locations)
                {
                    <option value="@l" selected="@(string.Equals(l, Model.Location, StringComparison.OrdinalIgnoreCase))">@l</option>
                }
            </select>
        </div>
        <div class="col-6 col-lg-2">
            <label for="from" class="form-label">From</label>
            <input id="from" name="from" type="date" class="form-control" value="@Model.From?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-6 col-lg-2">
            <label for="to" class="form-label">To</label>
            <input id="to" name="to" type="date" class="form-control" value="@Model.To?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-12 col-lg-1 d-flex gap-2">
            <button type="submit" class="btn btn-rd-primary w-100">Filter</button>
        </div>
    </div>
    @if (Model.HasFilters)
    {
        <a asp-action="Index" class="small d-inline-block mt-3">Clear filters</a>
    }
</form>

@if (Model.Events.Count == 0)
{
    <div class="rd-empty">
        <h2 class="rd-h2">@(Model.HasFilters ? "No events match those filters" : "No upcoming events yet")</h2>
        <p class="text-muted mb-0">@(Model.HasFilters ? "Try a wider date range or clear the filters." : "Check back soon. New races are added by organisers all the time.")</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var e in Model.Events)
        {
            <div class="col-12 col-md-6 col-xl-4"><partial name="_EventCard" model="e" /></div>
        }
    </div>
}
