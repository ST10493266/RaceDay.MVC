@model ProfileVm
@{ ViewData["Title"] = "Profile"; }
<div class="rd-pagehead">
    <h1 class="rd-h1">My profile</h1>
    <p class="text-muted mb-0">Keep your details up to date.</p>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="rd-panel text-center">
            @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl))
            {
                <img src="@Model.ProfilePictureUrl" alt="Your profile picture" class="rd-avatar" />
            }
            else
            {
                <div class="rd-avatar rd-avatar-empty" aria-label="No profile picture yet">@(string.IsNullOrWhiteSpace(Model.FullName) ? "?" : Model.FullName.Trim()[0].ToString().ToUpperInvariant())</div>
            }
            <h2 class="rd-h3 mt-3 mb-1">@Model.FullName</h2>
            <p class="text-muted small mb-0">@Model.Email</p>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="rd-panel">
            <form asp-action="Profile" method="post" enctype="multipart/form-data" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rd-alert"></div>
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="ProfilePictureUrl" />
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" required />
                    <span asp-validation-for="FullName" class="rd-field-error"></span>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" type="tel" />
                        <span asp-validation-for="PhoneNumber" class="rd-field-error"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="DateOfBirth" class="form-label"></label>
                        <input asp-for="DateOfBirth" class="form-control" type="date" value="@Model.DateOfBirth?.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="DateOfBirth" class="rd-field-error"></span>
                    </div>
                </div>
                <div class="mb-4">
                    <label asp-for="ProfilePicture" class="form-label"></label>
                    <input asp-for="ProfilePicture" class="form-control" type="file" accept="image/png,image/jpeg,image/webp" />
                    <div class="form-text">JPG, PNG or WebP, up to 5 MB.</div>
                    <span asp-validation-for="ProfilePicture" class="rd-field-error"></span>
                </div>
                <button type="submit" class="btn btn-rd-primary">Save changes</button>
            </form>
        </div>
    </div>
</div>
