@model RegisterVm
@{ ViewData["Title"] = "Create account"; }
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="rd-panel">
            <h1 class="rd-h1">Create your account</h1>
            <p class="text-muted">Enter races or run them. Choose the role that fits you.</p>
            <form asp-action="Register" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rd-alert"></div>
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" autocomplete="name" required />
                    <span asp-validation-for="FullName" class="rd-field-error"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" type="email" autocomplete="email" required />
                    <span asp-validation-for="Email" class="rd-field-error"></span>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Password" class="form-label">Password</label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" required minlength="8" />
                        <span asp-validation-for="Password" class="rd-field-error"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" required />
                        <span asp-validation-for="ConfirmPassword" class="rd-field-error"></span>
                    </div>
                </div>
                <fieldset class="mb-4">
                    <legend class="form-label fs-6">I want to</legend>
                    <div class="rd-choice-row">
                        <label class="rd-choice">
                            <input type="radio" asp-for="Role" value="Participant" />
                            <span><strong>Run events</strong><small>Browse races, enrol and track my results</small></span>
                        </label>
                        <label class="rd-choice">
                            <input type="radio" asp-for="Role" value="Organiser" />
                            <span><strong>Organise events</strong><small>Create races, manage entries and publish results</small></span>
                        </label>
                    </div>
                    <span asp-validation-for="Role" class="rd-field-error"></span>
                </fieldset>
                <button type="submit" class="btn btn-rd-primary w-100">Create account</button>
            </form>
            <p class="mt-3 mb-0 small">Already registered? <a asp-action="Login">Log in</a></p>
        </div>
    </div>
</div>
