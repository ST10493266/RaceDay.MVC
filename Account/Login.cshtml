@model LoginVm
@{ ViewData["Title"] = "Log in"; }
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="rd-panel">
            <h1 class="rd-h1">Log in</h1>
            <p class="text-muted">Pick up where you left off.</p>
            <form asp-action="Login" method="post" novalidate>
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rd-alert"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" type="email" autocomplete="email" required />
                    <span asp-validation-for="Email" class="rd-field-error"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" required />
                    <span asp-validation-for="Password" class="rd-field-error"></span>
                </div>
                <button type="submit" class="btn btn-rd-primary w-100">Log in</button>
            </form>
            <p class="mt-3 mb-0 small">New to RaceDay? <a asp-action="Register">Create an account</a></p>
        </div>
    </div>
</div>
